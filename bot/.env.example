# Copy this file to .env and fill in real values. Never commit .env.

# NSE Soko Play login (academy.nse.co.ke)
NSE_EMAIL=you@example.com
NSE_PASSWORD=your-password-here

# Supabase — same project your InvestIQ web app already uses
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Risk/policy knobs
BASE_CONFIDENCE_THRESHOLD=0.6
# Left unset on purpose — orchestrator.js treats a missing value as
# "no cap." This is virtual money on NSE's own education platform, so
# trade *count* isn't artificially limited; only real available cash
# limits trade *size* (see sizeTrade() in orchestrator.js).
# MAX_TRADES_PER_DAY=5

# Recommended ON while you're still validating the model: bypasses the
# gate entirely (gated_action == raw_action), so you get a clean,
# unfiltered per-stock accuracy record before any real gating decisions.
LEARNING_MODE=true

# Below this trade value (in account currency), a computed position is
# skipped rather than submitted — not a risk limit, just avoids a
# meaningless 0-or-1-share order.
MIN_TRADE_VALUE=1
